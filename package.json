{
  "name": "concert-booking-backend",
  "version": "1.0.0",
  "description": "Concert ticket booking platform using NestJS microservices",
  "private": true,
  "scripts": {
    "start": "echo 'Use start:dev or start:prod for specific services'",
    "start:dev": "concurrently \"npm run start:dev:auth\" \"npm run start:dev:booking\" \"npm run start:dev:concert\"",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:concert": "nest start concert-service --watch",
    "start:dev:booking": "nest start booking-service --watch",
    "start:prod:auth": "npm run build && node dist/apps/auth-service/main.js",
    "start:prod:concert": "npm run build && node dist/apps/concert-service/main.js",
    "start:prod:booking": "npm run build && node dist/apps/booking-service/main.js",
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint --ext .ts .",
    "format": "prettier --write \"**/*.ts\"",
    "seed": "ts-node concert-service/src/script/seed-mongo.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/microservices": "^10.4.17",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@types/amqplib": "^0.10.7",
    "amqplib": "^0.10.8",
    "bcrypt": "^5.1.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.6.1",
    "mongoose": "^7.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.4.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/redis": "^4.0.11",
    "concurrently": "^8.2.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
